# Database Configuration (PostgreSQL)
# Format: postgresql://username:password@localhost:5432/lexai_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lexai_db

# Gemini API Key (Required for LLM response generation)
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model
GEMINI_MODEL=gemini-2.5-flash

# Chroma Vector Database Path (Persistent local storage)
CHROMA_PATH=./backend/chroma

# Chroma Collection Name
CHROMA_COLLECTION_NAME=lexai_legal_chunks

# Embedding Model (Hugging Face / sentence-transformers)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Reranker Model (Optional local cross-encoder, e.g. cross-encoder/ms-marco-MiniLM-L-6-v2 or leave empty for fast cross-scoring/fallback)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Retrieval Top K candidates before reranking
RETRIEVAL_TOP_K=20

# Top K evidence chunks sent to LLM after reranking
RERANK_TOP_K=5

# Retrieval Weights
VECTOR_WEIGHT=0.6
KEYWORD_WEIGHT=0.4

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Internal Backend URL
LEXAI_API_URL=http://127.0.0.1:8001
